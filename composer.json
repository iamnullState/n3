{
    "name": "n3/core",
    "description": "N3 white-label modular CMS core",
    "type": "project",
    "version": "0.2.0",
    "license": "proprietary",
    "require": {
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "php": ">=8.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0"
    },
    "suggest": {
        "ext-gd": "Required when the optional Media module is enabled",
        "ext-pdo_mysql": "Required for MariaDB persistence and database integration tests"
    },
    "autoload": {
        "psr-4": {
            "N3\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "N3\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit",
        "check": [
            "@test"
        ]
    },
    "config": {
        "allow-plugins": {},
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
