# Copy this file to .env.docker before using the Docker test environment.
# These values are for an isolated local database only. Replace every password.

MARIADB_VERSION=11.8.9
N3_TEST_DB_HOST_PORT=3307
MARIADB_ROOT_PASSWORD=replace-with-a-long-local-root-password

N3_TEST_DB_NAME=n3_test
N3_TEST_DB_USER=n3_app
N3_TEST_DB_PASSWORD=replace-with-a-long-local-runtime-password
N3_TEST_DB_MIGRATION_USER=n3_migrator
N3_TEST_DB_MIGRATION_PASSWORD=replace-with-a-long-local-migration-password
N3_TEST_DB_BACKUP_USER=n3_backup
N3_TEST_DB_BACKUP_PASSWORD=replace-with-a-long-local-backup-password
